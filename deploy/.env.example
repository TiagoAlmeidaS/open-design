# ── Domínio ──────────────────────────────────────────────────────────
OPEN_DESIGN_DOMAIN=design.jarvispro.online

# ── Portas Traefik ───────────────────────────────────────────────────
# Se 80/443 já estiverem ocupadas, mude as portas do HOST (lado esquerdo).
# OBS: Let's Encrypt precisa da porta 80 para validar o certificado.
# Se mudar a 80, troque para DNS challenge ou libere a 80 antes.
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443

# ── Porta ────────────────────────────────────────────────────────────
OPEN_DESIGN_PORT=7456

# ── Origens CORS permitidas (separadas por vírgula) ──────────────────
OPEN_DESIGN_ALLOWED_ORIGINS=https://design.jarvispro.online

# ── Limite de memória do container ───────────────────────────────────
OPEN_DESIGN_MEM_LIMIT=384m

# ── Node options ─────────────────────────────────────────────────────
NODE_OPTIONS=--max-old-space-size=192
