# ── Domínio ──────────────────────────────────────────────────────────
OPEN_DESIGN_DOMAIN=design.jarvispro.online

# ── Porta ────────────────────────────────────────────────────────────
OPEN_DESIGN_PORT=7456

# ── Origens CORS permitidas (separadas por vírgula) ──────────────────
OPEN_DESIGN_ALLOWED_ORIGINS=https://design.jarvispro.online

# ── Limite de memória do container ───────────────────────────────────
OPEN_DESIGN_MEM_LIMIT=384m

# ── Node options ─────────────────────────────────────────────────────
NODE_OPTIONS=--max-old-space-size=192
